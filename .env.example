# Required — Agora project (Console → Default Project)
NEXT_PUBLIC_AGORA_APP_ID=

# Required — server-side only (never expose to the browser)
NEXT_AGORA_APP_CERTIFICATE=

# Legacy names still supported by the server if you have not renamed Vercel vars yet:
# AGORA_APP_ID=          (same as NEXT_PUBLIC_AGORA_APP_ID)
# AGORA_APP_CERTIFICATE= (same as NEXT_AGORA_APP_CERTIFICATE)

# Must match agentUid in invite-agent (lib/env.ts)
NEXT_PUBLIC_AGENT_UID=123456

# Optional opening line (spoken after delay below, not on immediate join)
NEXT_AGENT_GREETING=Hello! I'm listening. How can I help you today?

# Ms to wait after the agent joins before speaking the greeting (default 5000)
NEXT_AGENT_GREETING_DELAY_MS=5000

# Required for reliable LLM in production (fixes agent error 505 / LLM 401)
NEXT_LLM_API_KEY=
NEXT_LLM_URL=https://api.openai.com/v1/chat/completions

# Optional BYOK for STT/TTS if Agora-managed presets fail
# NEXT_DEEPGRAM_API_KEY=
# NEXT_MINIMAX_API_KEY=
# NEXT_MINIMAX_GROUP_ID=

# --- MCP tools + n8n (off by default) ---
# AGORA_ENABLE_TOOLS=true
# NEXORA_MCP_PUBLIC_URL=https://your-app.vercel.app
# MCP_AUTH_TOKEN=
# N8N_TOOL_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
# N8N_TOOL_ROUTES_JSON={"lookup_order":"https://..."}

# --- Agent quality tuning ---
# NEXORA_SILENCE_TIMEOUT_MS=25000
# NEXORA_IDLE_TIMEOUT_SEC=120
# NEXORA_VAD_SILENCE_MS=560

# RTM service uid for server-published session signals (default: NEXT_PUBLIC_AGENT_UID)
# NEXORA_RTM_SIGNAL_UID=

# --- Agora Console webhooks (ops / monitoring) ---
# AGORA_WEBHOOK_SECRET=

# Optional public site URL (fallback for MCP if NEXORA_MCP_PUBLIC_URL unset)
# NEXT_PUBLIC_SITE_URL=
